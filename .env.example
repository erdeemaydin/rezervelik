# Backend environment. Copy to `.env` for local dev; set these as real secrets in
# production/CI. Every value below has a safe fallback in code EXCEPT the ones you
# must change for production (JWT_SECRET, SETUP_SECRET_TOKEN, DATABASE_URL for a
# managed DB). Loaded by `dotenv` in src/server.ts and by Prisma.

# --- Database ---
# Prisma datasource URL — PostgreSQL (production, local dev, and tests all use PG).
# Local dev example (adjust user/password/db to your Postgres):
#
# connection_limit / pool_timeout: pin Prisma's connection pool explicitly.
# Without these, Prisma defaults the pool size to (num_physical_cpus * 2 + 1) —
# fine today since the backend still runs as a single PM2 instance (see
# PRODUCTION_ROADMAP.md — in-process workers and the in-memory rate limiter
# both require staying single-instance for now), but it's cheap/safe to pin
# now with headroom under whatever max_connections the production Postgres is
# actually configured with, rather than let it silently drift as CPU counts
# change across hosts. This sandbox can't inspect the live server's Postgres
# config, so the numbers below are a sane starting point, not a measured
# value — revisit once you know the real max_connections. This is a stopgap
# default, not a substitute for PRODUCTION_ROADMAP.md §8 Phase 2's plan to
# move to a managed Postgres (Turkey-region) once there are paying tenants —
# managed providers typically come with their own pooling story (e.g.
# PgBouncer in front) that should supersede this once adopted.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dining?schema=public&connection_limit=10&pool_timeout=10"

# Tests provision their OWN isolated Postgres (see npm run test:setup-db); they do
# NOT use DATABASE_URL. Override the test DB only if you don't want the auto
# throwaway container on :5433 — e.g. TEST_DATABASE_URL for CI service containers.
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dining_test?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Required to bootstrap the first SUPER_ADMIN via POST /api/system/setup-super-admin.
SETUP_SECRET_TOKEN="change-me"

# --- Server ---
PORT=3000

# --- CORS / cookies ---
# Comma-separated list of allowed browser origins (scheme+host+port, no
# trailing slash) — required for the httpOnly session cookie to work
# cross-origin. Falls back to APP_PUBLIC_URL, then http://localhost:3001.
# CORS_ORIGIN="http://localhost:3001"

# Cookie SameSite/Secure — defaults (lax / secure only in production) work for
# local dev and for frontend+backend on different PORTS of the same host
# (localhost, or a LAN IP). If frontend and backend are on genuinely different
# DOMAINS, set both of these (and put both behind HTTPS — see
# PRODUCTION_ROADMAP.md §1, already a pre-launch blocker regardless):
# COOKIE_SAME_SITE="none"
# COOKIE_SECURE="true"

# --- Object storage (uploaded menu photos / logos) ---
# Uploads (src/controllers/uploadController.ts) go through src/services/storage,
# which picks a provider at first use:
#   - S3_BUCKET set (or STORAGE_PROVIDER=s3) -> S3-compatible object storage.
#     Works unmodified against real AWS S3, Cloudflare R2, Backblaze B2, MinIO,
#     or anything else that speaks the S3 API — just point S3_ENDPOINT at it.
#   - Neither set -> local disk under public/uploads (LOCAL DEV ONLY). This is
#     the same footgun the old multer disk-storage had: most hosts (containers,
#     PaaS, serverless, anything with >1 instance) don't persist/share local
#     disk across redeploys or restarts, so uploaded files silently disappear.
#     Do NOT leave this unset in production — set the S3_* vars below.
#
# STORAGE_PROVIDER="s3"          # optional; forces the S3 provider explicitly instead of relying on S3_BUCKET being set
# S3_BUCKET="my-restaurant-uploads"
# S3_REGION="auto"               # "auto" works for R2; use a real AWS region (e.g. "us-east-1") for S3
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"  # omit entirely for real AWS S3
# S3_FORCE_PATH_STYLE="true"     # most non-AWS S3-compatible stores (R2, MinIO, B2 S3-compat) need this
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ACL=""                      # optional, e.g. "public-read"; leave unset for stores that reject ACLs (R2, many B2 setups)
# S3_PUBLIC_URL_BASE="https://cdn.your-domain.com"  # public base URL the bucket is served from (custom domain, R2 public bucket URL, or CloudFront/S3 website endpoint); returned upload URLs are "${S3_PUBLIC_URL_BASE}/<key>"

# Absolute base URL of THIS API (protocol+host, no trailing slash). Used to build
# absolute upload URLs when falling back to local disk, and (elsewhere) as a
# fallback for links embedded outside the request context. If unset, local-disk
# uploads fall back to the incoming request's own protocol+host.
# API_PUBLIC_URL="https://api.your-domain.com"

# --- Google reviews (src/controllers/reviewController.ts) ---
# Places API key used to fetch a tenant's live Google rating/reviews and to
# resolve the Place ID behind whatever Maps link they paste in
# dashboard/reviews. Without this set, GET /api/reviews returns
# configured:true, apiKeyMissing:true and the dashboard shows a "connect"
# prompt instead of real review data — the feature is otherwise silently
# disabled. Enable the "Places API" (and "Places API (New)" if using a newer
# key) in Google Cloud Console and restrict the key to those APIs.
# GOOGLE_PLACES_API_KEY="..."

# --- Error tracking (optional) ---
# Sentry DSN for backend error tracking (src/config/sentry.ts). Leave unset in local
# dev/CI — Sentry.init() is skipped entirely and every Sentry.* call elsewhere in the
# app becomes a no-op. Set this in production only after creating a Sentry project;
# see docs/MONITORING.md for the manual setup steps (this repo can't create one for you).
# SENTRY_DSN="https://<key>@o<org>.ingest.<region>.sentry.io/<project>"

# --- KVKK data retention (src/workers/retentionAnonymizer.ts) ---
# Days after a reservation's date (or a waitlist entry's join date) before its
# PII (name/phone/email/notes) is nulled out by the daily retention worker.
# Default 400 (~1 year + buffer) if unset — see PRODUCTION_ROADMAP.md §3/§7.
# RETENTION_DAYS=400

# --- Post-deploy smoke test (scripts/smoke-test.mjs) ---
# SMOKE_BASE_URL="https://api.your-domain.com"
# SMOKE_EMAIL="smoke@your-domain.com"
# SMOKE_PASSWORD="..."
# SMOKE_RESTAURANT_ID="<a Restaurant.id>"
