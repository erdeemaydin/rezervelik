# Backend environment. Copy to `.env` for local dev; set these as real secrets in
# production/CI. Every value below has a safe fallback in code EXCEPT the ones you
# must change for production (JWT_SECRET, SETUP_SECRET_TOKEN, DATABASE_URL for a
# managed DB). Loaded by `dotenv` in src/server.ts and by Prisma.

# --- Database ---
# Prisma datasource URL — PostgreSQL (production, local dev, and tests all use PG).
# Local dev example (adjust user/password/db to your Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dining?schema=public"

# Tests provision their OWN isolated Postgres (see npm run test:setup-db); they do
# NOT use DATABASE_URL. Override the test DB only if you don't want the auto
# throwaway container on :5433 — e.g. TEST_DATABASE_URL for CI service containers.
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/dining_test?schema=public"

# --- Auth ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Required to bootstrap the first SUPER_ADMIN via POST /api/system/setup-super-admin.
SETUP_SECRET_TOKEN="change-me"

# --- Server ---
PORT=3000

# --- Post-deploy smoke test (scripts/smoke-test.mjs) ---
# SMOKE_BASE_URL="https://api.your-domain.com"
# SMOKE_EMAIL="smoke@your-domain.com"
# SMOKE_PASSWORD="..."
# SMOKE_RESTAURANT_ID="<a Restaurant.id>"
