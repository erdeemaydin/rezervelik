# Frontend environment. Copy to `frontend/.env`.
#
# NEXT_PUBLIC_* values are baked in at BUILD time (next build), not read at runtime,
# so you must rebuild the frontend after changing them.

# Base URL of the backend API.
# - Local dev: leave unset — the app falls back to `http://<current-host>:3000/api`,
#   so it works on localhost AND when you open the dev server from another device on
#   your LAN (e.g. http://192.168.0.82:3001 -> http://192.168.0.82:3000/api).
# - Production: set this to your same-origin HTTPS API path so the browser calls the
#   API over TLS through Nginx (which proxies /api -> backend:3000):
#     NEXT_PUBLIC_API_URL=https://your-domain.com/api
# NEXT_PUBLIC_API_URL=
