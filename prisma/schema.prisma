generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           String  @id @default(uuid())
  slug         String  @unique
  name         String
  contactEmail String
  contactPhone String?
  logoUrl      String?
  isActive     Boolean @default(true)

  // Vertical / business type. Drives per-tenant terminology labels and default
  // feature profile. Set by the SysAdmin (like layoutStyle), never by the tenant.
  // RESTAURANT, SALON, SPORTS, COWORKING, CLINIC, WEDDING. See MULTI_BUSINESS_ROADMAP.md.
  businessType String @default("RESTAURANT")

  // Subscription & Billing
  subscriptionPlan   String    @default("TRIAL") // TRIAL, BASIC, PRO, PREMIUM
  subscriptionStatus String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  subscriptionEndsAt DateTime?
  stripeCustomerId   String?
  sysAdminNotes      String?

  // --- Commercial add-on packages (set by SysAdmin, never by the tenant) ---
  // See docs/packaging/ for the sales/positioning of these two packages.
  //
  // "Hosted Frontend" package: we host the tenant's public booking site on THEIR
  // own domain (customDomain). When off, the tenant is expected to keep their own
  // website and embed the reservation widget instead.
  hasHostedFrontend      Boolean   @default(false)
  // The customer's own domain (e.g. "reservations.lebistro.com"). DNS is pointed
  // at us via CNAME; Caddy on-demand TLS issues the cert. Host-header routing maps
  // this domain to /r/[slug] so the end customer never sees our subdomain.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  //
  // "Reservation Widget" package: an embeddable booking module (JS embed + iframe,
  // plus native SDKs) the tenant drops into their own existing website.
  hasReservationWidget   Boolean   @default(false)
  // Publishable key ("pk_live_...") that scopes public widget/SDK calls to this
  // tenant WITHOUT exposing the internal restaurant UUID. Rotatable by the SysAdmin.
  publicApiKey           String?   @unique

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  menus                 Menu[]
  reservations          Reservation[]
  settings              RestaurantSettings?
  tables                BookableResource[]
  tableTypes            Zone[]
  users                 User[]
  categories            ReservationCategory[]
  daySettings           DaySetting[]
  shifts                Shift[]
  waitTimeConfig        WaitTimeConfig?
  waitlistEntries       WaitlistEntry[]
  floorElements         FloorElement[]
  customization         FrontendCustomization?
  scheduledPriceUpdates ScheduledPriceUpdate[]
  payments              Payment[]
  timeEntries           TimeEntry[]
  events                Event[]
  paymentPlans          PaymentPlan[]
  guests                Guest[]
  vendors               Vendor[]
  eventVendors          EventVendor[]
  auditLogs             AuditLog[]
}

model FrontendCustomization {
  id           String @id @default(uuid())
  restaurantId String @unique

  // New Theming Architecture
  layoutStyle  String @default("CLASSIC_LIST") // CLASSIC_LIST, EDITORIAL_IMAGE, ANIMATED, GARDEN_FRESH, NOIR_LOUNGE, NORDIC_MINIMAL, TRATTORIA_RUSTIC, BOLD_EDITORIAL
  typography   String @default("SANS") // SANS, SERIF, MONO
  colorPalette String @default("OBSIDIAN") // OBSIDIAN, PEARL, EARTH

  primaryColor String @default("#0f172a") // Keep for backwards compat or custom overrides

  // Features
  announcementText String?
  showAboutUs      Boolean @default(false)
  aboutUsText      String?
  showLegal        Boolean @default(false)
  legalText        String?
  socialLinks      String? // JSON string

  // Reservation Warnings & Information
  reservationInfoText    String?
  reservationWarningText String?

  // KVKK "aydınlatma metni" (privacy/disclosure notice) shown at booking time and
  // linked from the consent checkbox. Optional per-tenant override of the generic
  // bilingual default text shipped in the frontend (public.privacyNotice.* i18n
  // keys) — most tenants can rely on the default; this lets a tenant supply their
  // own restaurant-specific notice, same pattern as legalText/aboutUsText above.
  privacyNoticeText String?

  updatedAt  DateTime   @updatedAt
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model ScheduledPriceUpdate {
  id           String    @id @default(uuid())
  restaurantId String
  updateType   String // PERCENTAGE, FIXED_AMOUNT, EXPLICIT_SET
  value        Float
  isIncrease   Boolean   @default(true)
  // For updateType = EXPLICIT_SET: JSON array of { id, price } target prices set
  // from the bulk price editor (used when the change is scheduled for later).
  payload      String?
  status       String    @default("PENDING") // PENDING, APPLIED, FAILED
  scheduledFor DateTime
  appliedAt    DateTime?

  createdAt  DateTime   @default(now())
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([restaurantId])
}

model RestaurantSettings {
  id                       String  @id @default(uuid())
  restaurantId             String  @unique
  isReservationEnabled     Boolean @default(true)
  logic                    String  @default("DYNAMIC_DURATION")
  defaultDurationMinutes   Int     @default(90)
  // Default unpaid break (minutes) deducted from a scheduled shift when computing
  // worked hours. When a staff member is assigned to a shift but has entered no
  // explicit check-in/out, they are credited with the shift's length minus this
  // break. Admin-configurable; 0 means the full shift counts as worked.
  defaultBreakMinutes      Int     @default(0)
  isPaidReservationEnabled Boolean @default(false)
  depositAmount            Float?
  currency                 String  @default("TRY")
  // Largest party a guest can pick on the public booking form (rendered as
  // 1..maxPartySize bubble buttons). Admin-configurable.
  maxPartySize             Int     @default(8)
  operatingHours           String?
  // Service window as whole hours (0-23), admin-configurable. Drives the public
  // booking time options and bounds the analytics peak-hours heatmap axis so it
  // only spans the hours the restaurant is actually open.
  openingHour              Int     @default(10)
  closingHour              Int     @default(23)
  // IANA timezone (e.g. "Europe/Istanbul") — the authoritative wall-clock zone for
  // this restaurant. Public booking interprets/display times in this zone, and the
  // backend derives the reservation's calendar day (for DaySetting lookups) from it.
  timezone                 String  @default("Europe/Istanbul")

  // Overbooking: when no table is physically free for a public booking request
  // but the party size could fit somewhere in the restaurant, admins can opt in
  // to soft-accepting the request as PENDING (for manual staff review) instead
  // of hard-rejecting it. Only takes effect when both caps below are set to a
  // positive integer — see getEffectiveOverbookingConfig in reservationConflict.ts.
  // DaySetting can override this per date.
  allowOverbooking                Boolean @default(false)
  overbookingMaxExtraCovers       Int?
  overbookingMaxExtraReservations Int?

  schedulingSystem String @default("MONTHLY") // "WEEKLY" or "MONTHLY"

  // Feature flags controlled by System Admin
  isVipEnabled           Boolean @default(true)
  isInternalNotesEnabled Boolean @default(true)
  isCategoriesEnabled    Boolean @default(true)

  hasWaitTimeFeature Boolean @default(true)
  hasShiftFeature    Boolean @default(true)
  hasMenuFeature     Boolean @default(true)
  hasPaymentFeature  Boolean @default(true)

  // Wedding/organization vertical capabilities (default off; SysAdmin enables via
  // the WEDDING business profile). See MULTI_BUSINESS_ROADMAP.md Phase 4.
  hasEventPipeline    Boolean @default(false) // Event sales pipeline (lead → confirmed)
  hasInstallmentPlans Boolean @default(false) // kapora + taksit payment schedules
  hasGuestList        Boolean @default(false) // guest list, RSVP, seating assignment
  hasVendors          Boolean @default(false) // external vendor coordination (organizer model)

  // Privacy & Staff View Settings
  staffScheduleView String @default("OWN_ONLY") // "OWN_ONLY", "SHIFT_TEAM", "FULL_ROSTER"

  // Two-factor authentication. `twoFactorEnabled` is a capability flag toggled
  // ONLY by the root/system admin per restaurant. When enabled, the tenant admin
  // chooses which roles must use 2FA via `twoFactorRoles` (comma-separated, e.g.
  // "ADMIN,MANAGER"). Staff are excluded by default (empty list).
  twoFactorEnabled Boolean @default(false)
  twoFactorRoles   String  @default("")

  // Default UI language for this tenant, set by the root/system admin. Applied on
  // the dashboard when a user hasn't explicitly picked a language yet. "tr" is the
  // platform default.
  defaultLanguage String @default("tr")

  // Whether the tenant's own admins/managers may view the activity audit log for
  // their restaurant. Root/system-admin decides this per tenant; default off so
  // the audit trail is a platform-admin tool unless explicitly shared.
  showAuditLogToTenant Boolean @default(false)

  // Admin dashboard color theme for this tenant. Chosen by the tenant admin (or
  // the root admin per tenant); ALL of the tenant's staff inherit it since they
  // all read the same RestaurantSettings. One of the ids in
  // frontend/src/lib/themes.ts (e.g. "default", "terracotta", "forest",
  // "burgundy", "amber").
  dashboardTheme String @default("default")

  // Google Business Profile link for surfacing real Google reviews on the
  // dashboard Reviews page. The tenant pastes their Google Maps place URL
  // (googleMapsUrl); the backend resolves a Place ID (googlePlaceId) from it for
  // the Places Details API. Replying to reviews (Google OAuth) is a later phase.
  googleMapsUrl String?
  googlePlaceId String?

  updatedAt  DateTime   @updatedAt
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// Immutable-by-convention activity trail. A null restaurantId marks a
// platform-level (system-admin) action; a set restaurantId scopes the entry to a
// single tenant so it can surface in that tenant's own audit view. Actor identity
// is snapshotted (email/name/role) so the record survives user deletion.
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Who did it (snapshot — not a hard FK, so deleting the user keeps the record).
  actorId    String?
  actorEmail String?
  actorName  String?
  actorRole  String?

  // Scope: null = platform-level; otherwise the tenant the action belongs to.
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // What happened.
  action      String // e.g. LOGIN, TENANT_PROVISIONED, SETTINGS_UPDATED
  category    String // e.g. AUTH, TENANT, SETTINGS, RESERVATION, SYSTEM
  targetType  String? // e.g. Restaurant, User, Reservation
  targetId    String?
  targetLabel String? // human-readable name of the target
  metadata    Json? // arbitrary extra detail
  ip          String?

  @@index([restaurantId, createdAt])
  @@index([category])
  @@index([actorId])
}

model WaitTimeConfig {
  id                   String  @id @default(uuid())
  restaurantId         String  @unique
  isWaitlistOpen       Boolean @default(false)
  isWaitTimeEnabled    Boolean @default(false)
  isWaitTimeCalculated Boolean @default(false) // false = manual, true = calculated

  // Manual Mode
  manualWaitTimeLower Int? // e.g., 30
  manualWaitTimeUpper Int? // e.g., 40

  // Calculated Mode
  peopleWaiting          Int @default(0)
  waitTimePerPersonLower Int @default(5) // in minutes
  waitTimePerPersonUpper Int @default(8) // in minutes

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id           String @id @default(uuid())
  restaurantId String
  // Nullable — same KVKK retention rationale as Reservation.customerName/
  // customerPhone: the retention/anonymization worker nulls these out (plus
  // notes, which is free text and may contain PII) once an entry ages past the
  // retention window. Still required at creation time by controller validation.
  customerName   String?
  customerPhone  String?
  partySize      Int
  quotedWaitTime Int? // in minutes
  status         String  @default("WAITING") // WAITING, NOTIFIED, SEATED, CANCELED, NO_SHOW
  notes          String?
  targetDate     String? // YYYY-MM-DD for date-based reservations waitlist

  // Future Reservation Offer Fields
  offerToken     String?   @unique
  offerExpiresAt DateTime?
  offeredTime    String? // e.g. "19:30"

  joinedAt     DateTime  @default(now())
  notifiedAt   DateTime?
  seatedAt     DateTime?
  anonymizedAt DateTime? // set by the retention/anonymization worker; null = not yet anonymized

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}

model User {
  id           String  @id @default(uuid())
  restaurantId String?
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String  @default("STAFF") // SUPER_ADMIN, ADMIN, MANAGER, STAFF
  permissions  String? // Comma-separated permission keys e.g. "manage_reservations,manage_menu"
  // Meaningful only for role === SUPER_ADMIN. true = full platform root (every
  // /api/system/* action, no restrictions). false = a restricted "sub-admin"
  // scoped to whatever `permissions` (sys_* keys, see src/config/systemPermissions.ts)
  // grants — see requireSystemPermission/requireRootSystemAdmin in middlewares/auth.ts.
  // Defaults true so every pre-existing SUPER_ADMIN keeps full access unchanged.
  isRootAdmin  Boolean @default(true)
  // Revocation switch — there was previously no way to disable a
  // compromised/offboarded account (SUPER_ADMIN most critically) through the
  // product, only directly in the DB. Checked at login (blocks new sessions)
  // and, for SUPER_ADMIN specifically, on every system-admin request too
  // (blocks an already-issued token from continuing to work).
  isActive     Boolean @default(true)
  // E.164 phone (e.g. "+905551234567"). Required for staff so published shift
  // plans can be sent over WhatsApp (#7.6).
  phone        String?

  // Tenant-invite setup token: only the SHA-256 hash is stored, never the raw
  // token, same as resetTokenHash below — the raw token lives only in the
  // one-time setup link handed to the new tenant admin.
  setupTokenHash      String?   @unique
  setupTokenExpiresAt DateTime?

  // Password reset: only the SHA-256 hash of the token is stored, never the raw
  // token. The raw token lives only in the reset link handed out once.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  // Two-factor (TOTP) authentication. `otpRequired` is toggled only by the root
  // admin; `otpSecret` (base32) is set when the user enrolls; `otpConfirmedAt`
  // marks a completed enrollment. Login enforces OTP only when required + confirmed.
  otpRequired    Boolean   @default(false)
  otpSecret      String?
  otpConfirmedAt DateTime?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  restaurant        Restaurant?            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  availabilities    EmployeeAvailability[]
  shiftAssignments  ShiftAssignment[]
  timeEntries       TimeEntry[]
  coordinatedEvents Event[]                @relation("EventCoordinator")

  @@index([restaurantId])
}

// Actual worked-time records entered by staff (own portal) or the admin, per day
// and optionally per shift. When absent, worked hours default to the scheduled
// shift's defined duration (#7.8-#7.10). Times are wall-clock "HH:MM".
model TimeEntry {
  id           String  @id @default(uuid())
  restaurantId String
  userId       String
  date         String // YYYY-MM-DD
  shiftId      String? // optional link to the scheduled shift
  checkIn      String? // "HH:MM"
  checkOut     String? // "HH:MM"
  breakMinutes Int     @default(0)
  source       String  @default("MANUAL") // MANUAL, AUTO
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, date, shiftId])
  @@index([restaurantId])
  @@index([userId])
}

// Canonical name: Zone (a grouping of bookable resources — restaurant section,
// salon station, sports area, clinic department, wedding venue area). Kept mapped
// to the original "TableType" SQL table so no data migration is needed.
model Zone {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  description  String?

  parentId String?
  parent   Zone?   @relation("SubZones", fields: [parentId], references: [id])
  children Zone[]  @relation("SubZones")

  tables        BookableResource[]
  floorElements FloorElement[]
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([parentId])
  @@map("TableType")
}

// Canonical name: BookableResource (the unit a booking reserves — restaurant table,
// salon chair, sports court, coworking room, wedding hall). Kept mapped to the
// original "Table" SQL table so no data migration is needed. Relation/field names
// (tableTypeId, tableType, reservations) are retained to keep API shapes stable.
model BookableResource {
  id           String  @id @default(uuid())
  restaurantId String
  tableTypeId  String
  identifier   String
  capacity     Int
  isAvailable  Boolean @default(true)

  // Floor Plan Visuals
  positionX Float   @default(0)
  positionY Float   @default(0)
  shape     String  @default("rectangle") // rectangle, circle
  width     Float   @default(60)
  height    Float   @default(60)
  color     String? @default("#ffffff")

  reservations Reservation[]
  events       Event[]       @relation("EventHall")
  seatedGuests Guest[]       @relation("GuestSeat")
  tableType    Zone          @relation(fields: [tableTypeId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tableTypeId])
  @@map("Table")
}

model FloorElement {
  id           String  @id @default(uuid())
  restaurantId String
  tableTypeId  String
  type         String  @default("box") // 'box', 'text', 'wall', 'divider'
  label        String?
  positionX    Float   @default(0)
  positionY    Float   @default(0)
  width        Float   @default(200)
  height       Float   @default(200)
  color        String? @default("#f8fafc")

  tableType  Zone       @relation(fields: [tableTypeId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tableTypeId])
}

model DaySetting {
  id                                      String     @id @default(uuid())
  restaurantId                            String
  date                                    String // ISO Date string (YYYY-MM-DD)
  eventTitle                              String?
  isReservationEnabled                    Boolean    @default(true)
  isFullyBooked                           Boolean    @default(false)
  autoConfirm                             Boolean    @default(false) // If true, skip PENDING and go to CONFIRMED
  maxCapacityOverride                     Int? // Optional: limit capacity for special events
  // Per-day override of RestaurantSettings' overbooking feature (null = inherit
  // the restaurant-wide setting). Same "only takes effect when both caps are set"
  // rule as the global fields.
  allowOverbookingOverride                Boolean?
  overbookingMaxExtraCoversOverride       Int?
  overbookingMaxExtraReservationsOverride Int?
  restaurant                              Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

model ReservationCategory {
  id           String        @id @default(uuid())
  restaurantId String
  name         String // Online, Phone, Walk-In
  color        String? // Optional color for UI
  isActive     Boolean       @default(true)
  reservations Reservation[]
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Reservation {
  id               String    @id @default(uuid())
  restaurantId     String
  tableId          String?
  categoryId       String?
  // Appointment verticals (SALON/CLINIC): the service/treatment this booking is
  // for. When set and the service has durationMinutes, the booking window is
  // derived from it instead of RestaurantSettings.defaultDurationMinutes. Optional
  // and unused by restaurants.
  serviceId        String?
  // Nullable so the retention/anonymization worker can null out PII once a
  // reservation ages past the retention window, while keeping the row (and its
  // aggregate fields: guestCount, startTime, status, table, isVIP...) for
  // statistics. Still required at creation time by controller-level validation.
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  guestCount       Int
  startTime        DateTime
  endTime          DateTime?
  status           String    @default("PENDING")
  notes            String? // Customer note
  internalNote     String? // Internal/Restaurant note
  isVIP            Boolean   @default(false)
  isPaid           Boolean   @default(false)
  paymentId        String?
  // Set when this PENDING reservation was soft-accepted with no table assigned
  // under the RestaurantSettings/DaySetting overbooking feature (no table was
  // free at request time, but the party could fit somewhere). Counted against
  // the overbooking caps for its date — see getOverbookedCountsForDate.
  isOverbooked     Boolean   @default(false)
  // Short guest-facing lookup code (e.g. "482913"), generated once at booking
  // time. Lets host-stand staff pull up a reservation by code instead of
  // searching by name when a guest gives it. Nullable so legacy rows created
  // before this field existed don't need a backfill — Postgres treats
  // multiple NULLs as distinct under the unique constraint below, so they
  // don't collide with each other or with real codes.
  confirmationCode String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // --- KVKK consent (PRODUCTION_ROADMAP.md §7.3) ---
  // consentAccepted: required "açık rıza" for the booking itself (data processing
  // needed to fulfill the reservation) — checked at submission time on the public
  // booking form and enforced server-side in reservationController.createReservation
  // for guest-initiated (non-staff) requests. Staff-entered bookings (dashboard/host
  // screen, phone/walk-in) are exempt server-side since there's no browser checkbox
  // for the staff member to check on the guest's behalf.
  // marketingConsent: a SEPARATE, optional opt-in for WhatsApp/marketing contact —
  // must never be bundled with consentAccepted (§7.3 is explicit this has to be a
  // distinct checkbox, not implied by booking).
  // consentTimestamp: when the consent choice was captured (same moment for both
  // flags today, since they're captured on the same form submission).
  consentAccepted  Boolean   @default(false)
  marketingConsent Boolean   @default(false)
  consentTimestamp DateTime?

  // Set by the retention/anonymization worker (src/workers/retentionAnonymizer.ts)
  // once this row's PII (name/email/phone) has been cleared for having passed the
  // retention window (RETENTION_DAYS env var, default 400 days). Null = not yet
  // anonymized. Kept (not deleted) so aggregate/statistical fields — guestCount,
  // startTime, status, table, isVIP, etc. — remain available for analytics.
  anonymizedAt DateTime?

  table      BookableResource?    @relation(fields: [tableId], references: [id])
  category   ReservationCategory? @relation(fields: [categoryId], references: [id])
  service    MenuItem?            @relation(fields: [serviceId], references: [id])
  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@unique([restaurantId, confirmationCode])
  @@index([restaurantId])
  // Every hot-path reservation query (dashboard list, analytics windows, the
  // recent-activity/weekly-count widgets) filters by restaurantId AND a
  // startTime range together. The separate single-column indexes below force
  // Postgres to pick one and re-filter the rest row-by-row; this composite
  // lets it satisfy both predicates directly from a single index range scan.
  @@index([restaurantId, startTime])
  @@index([tableId])
  @@index([categoryId])
  @@index([serviceId])
  @@index([startTime])
  @@index([anonymizedAt])
}

// A payment attempt for a reservation deposit. Provider-agnostic: `provider`
// records which gateway (PAYTR / MOCK / …) handled it. Amounts are stored in
// MINOR units (kuruş/cents) as integers to avoid floating-point money bugs.
// Card data never touches this table — the customer enters it in the provider's
// hosted iframe (PCI SAQ A).
model Payment {
  id            String  @id @default(uuid())
  restaurantId  String
  reservationId String?
  provider      String  @default("PAYTR") // PAYTR, MOCK, STRIPE, IYZICO
  merchantOid   String  @unique // our order id echoed back by the provider callback
  providerRef   String? // provider-side transaction reference
  amount        Int // minor units (e.g. kuruş)
  currency      String  @default("TL")
  status        String  @default("PENDING") // PENDING, PAID, FAILED, EXPIRED, REFUNDED

  // Customer access to the hosted payment page. Only the SHA-256 hash of the raw
  // link token is stored; the raw token lives only in the payment link. `code` is
  // a short human-typeable fallback so guests can reach payment from the known site
  // instead of trusting a raw SMS link (anti-phishing).
  linkTokenHash String   @unique
  code          String
  expiresAt     DateTime

  paidAt      DateTime?
  failReason  String?
  rawCallback String? // JSON of the last provider callback, for audit

  refundedAt   DateTime?
  refundReason String?
  rawRefund    String? // JSON of the last provider refund response, for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([reservationId])
  @@index([code])
  @@index([status])
}

model Menu {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  // Only one Menu per restaurantId may have isActive = true. Enforced by a partial unique
  // index (Menu_restaurantId_active_unique) added out-of-band in migration
  // 20260808175255_add_menu_single_active_constraint — Prisma's schema DSL can't express a
  // filtered/partial unique index, so it won't show up here as an @@unique.
  isActive     Boolean @default(true)
  footnotes    String?

  // Scheduling
  startTime  String? // e.g. "10:00"
  endTime    String? // e.g. "14:00"
  daysOfWeek String? // e.g. "1,2,3,4,5" (0=Sun, 6=Sat)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  @@index([restaurantId])
}

model MenuCategory {
  id          String  @id @default(uuid())
  menuId      String
  name        String
  description String?
  imageUrl    String?
  order       Int     @default(0)

  parentId String?
  parent   MenuCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  children MenuCategory[] @relation("SubCategories")

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([menuId])
  @@index([parentId])
}

model MenuItem {
  id              String  @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  price           Float
  imageUrl        String?
  isAvailable     Boolean @default(true)
  isHighlight     Boolean @default(false) // Chef's Special / Popular
  order           Int     @default(0)
  dietaryTags     String? // e.g., "Vegan,Gluten-Free"
  allergens       String? // e.g., "Nuts,Dairy"
  spiceLevel      Int     @default(0) // 0: none, 1: mild, 2: medium, 3: spicy
  // Appointment verticals: intrinsic service/treatment length in minutes. When set
  // on the service a booking references (Reservation.serviceId), it drives the
  // booking window instead of the tenant's default duration. Null for menu dishes.
  durationMinutes Int?

  // Regulation Fields
  ingredients     String?
  calories        Int?
  containsAlcohol Boolean @default(false)
  containsPork    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  modifiers    MenuItemModifier[]
  pairings     MenuItemPairing[]  @relation("ItemPairings")
  pairedWith   MenuItemPairing[]  @relation("PairedItems")
  reservations Reservation[]
  events       Event[]            @relation("EventPackage")

  @@index([categoryId])
}

model MenuItemModifier {
  id         String  @id @default(uuid())
  menuItemId String
  name       String // e.g., "Meat Temperature", "Add-ons"
  isRequired Boolean @default(false)
  minChoices Int     @default(0)
  maxChoices Int? // null means unlimited

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([menuItemId])
}

model ModifierOption {
  id          String  @id @default(uuid())
  modifierId  String
  name        String // e.g., "Rare", "Add Bacon"
  priceAdjust Float   @default(0) // e.g., 2.00
  isAvailable Boolean @default(true)

  modifier MenuItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@index([modifierId])
}

model MenuItemPairing {
  id           String @id @default(uuid())
  menuItemId   String
  pairedItemId String

  menuItem   MenuItem @relation("ItemPairings", fields: [menuItemId], references: [id], onDelete: Cascade)
  pairedItem MenuItem @relation("PairedItems", fields: [pairedItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, pairedItemId])
  @@index([menuItemId])
  @@index([pairedItemId])
}

model Shift {
  id           String   @id @default(uuid())
  restaurantId String
  name         String // e.g., "Morning Shift", "Evening Shift"
  startTime    String // e.g., "08:00"
  endTime      String // e.g., "16:00"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant      Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignments     ShiftAssignment[]
  availabilities  EmployeeAvailability[]
  dayRequirements ShiftDayRequirement[]

  @@index([restaurantId])
}

model ShiftDayRequirement {
  id            String @id @default(uuid())
  shiftId       String
  dayOfWeek     Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  requiredStaff Int    @default(1)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, dayOfWeek])
  @@index([shiftId])
}

model ShiftAssignment {
  id          String   @id @default(uuid())
  shiftId     String
  userId      String
  date        String // ISO Date string (YYYY-MM-DD)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId, date])
  @@index([shiftId])
  @@index([userId])
}

model EmployeeAvailability {
  id          String   @id @default(uuid())
  userId      String
  shiftId     String
  date        String // ISO Date string (YYYY-MM-DD)
  isAvailable Boolean  @default(true)
  notes       String? // Reason if not available or preference
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, shiftId, date])
  @@index([userId])
  @@index([shiftId])
}

model GlobalSettings {
  id                        String   @id @default("global_1")
  maintenanceMode           Boolean  @default(false)
  publicRegistrationEnabled Boolean  @default(true)
  enforce2FAForAdmins       Boolean  @default(true)
  // Platform-wide date/time display convention, set by the root system admin.
  // "METRIC" = European/Turkish style: DD/MM/YYYY dates + 24-hour clock.
  // "US"     = United States style: MM/DD/YYYY dates + 12-hour clock (AM/PM).
  measurementSystem         String   @default("METRIC")
  // Color theme for the system-admin (root) surface itself. Same theme ids as the
  // tenant dashboard (frontend/src/lib/themes.ts). Set by the root system admin.
  dashboardTheme            String   @default("default")
  updatedAt                 DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Wedding / organization vertical (Phase 4). New domain isolated in these models.
// An Event is a high-value single-date booking with a sales pipeline, an optional
// per-person package, an installment payment plan (kapora + taksit), and a guest
// list with RSVP + seating. See MULTI_BUSINESS_ROADMAP.md §6.
// ---------------------------------------------------------------------------

model Event {
  id            String  @id @default(uuid())
  restaurantId  String
  resourceId    String? // the Hall (BookableResource) reserved for this date-slot
  packageId     String? // per-person package (MenuItem/CatalogItem)
  coordinatorId String? // assigned staff (User)

  eventType   String  @default("WEDDING") // WEDDING, ENGAGEMENT, HENNA, CORPORATE
  clientName  String
  clientPhone String
  clientEmail String?
  eventDate   String // YYYY-MM-DD (single date-slot; availability via DaySetting-style)
  slot        String? // e.g. "EVENING" / "AFTERNOON"
  guestCount  Int     @default(0)
  // Sales pipeline stage. Transitions validated in the controller.
  stage       String  @default("LEAD") // LEAD, VISIT, QUOTE, CONTRACT, CONFIRMED, COMPLETED, CANCELED
  quotedTotal Int? // minor units (kuruş)
  notes       String?

  // Contract / proposal tracking (Phase 5). The quote is derived from
  // package × guestCount (quotedTotal); the contract is an uploaded/linked doc.
  contractUrl      String? // link to the signed contract document
  contractSignedAt DateTime?
  proposalSentAt   DateTime? // when the quote/proposal was sent to the client

  // e-davetiye (invitation microsite, Phase 5). `publicToken` is the shareable
  // key for the public RSVP page; guests self-serve their RSVP into the guest list.
  publicToken       String? @unique
  invitationMessage String? // custom greeting shown on the invitation
  venueName         String? // display venue/location name on the invitation
  venueAddress      String? // free-text address for the invitation map/link

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resource    BookableResource? @relation("EventHall", fields: [resourceId], references: [id])
  package     MenuItem?         @relation("EventPackage", fields: [packageId], references: [id])
  coordinator User?             @relation("EventCoordinator", fields: [coordinatorId], references: [id])
  paymentPlan PaymentPlan?
  guests      Guest[]
  vendors     EventVendor[]

  @@index([restaurantId])
  @@index([eventDate])
  @@index([stage])
}

model PaymentPlan {
  id           String @id @default(uuid())
  restaurantId String
  eventId      String @unique // one plan per event
  totalAmount  Int    @default(0) // minor units
  currency     String @default("TRY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  installments PaymentInstallment[]

  @@index([restaurantId])
}

model PaymentInstallment {
  id        String    @id @default(uuid())
  planId    String
  label     String? // e.g. "Kapora", "1. Taksit"
  dueDate   String // YYYY-MM-DD
  amount    Int // minor units
  status    String    @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt    DateTime?
  paymentId String? // links to an existing Payment row when charged

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

model Guest {
  id           String    @id @default(uuid())
  restaurantId String
  eventId      String
  resourceId   String? // seating: assigned guest table (BookableResource)
  name         String
  partySize    Int       @default(1)
  rsvp         String    @default("PENDING") // PENDING, YES, NO, MAYBE
  dietary      String?
  note         String?
  respondedAt  DateTime? // set when the guest self-responds via the invitation microsite

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource   BookableResource? @relation("GuestSeat", fields: [resourceId], references: [id])

  @@index([restaurantId])
  @@index([eventId])
}

// External vendors an organizer coordinates for events (photographer, DJ,
// florist, catering…). Owned per-tenant; linked to specific events via
// EventVendor. Gated by the `hasVendors` feature flag (WEDDING profile default).
// See MULTI_BUSINESS_ROADMAP.md Phase 5.
model Vendor {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  category     String  @default("OTHER") // PHOTOGRAPHER, VIDEOGRAPHER, DJ, MUSIC, FLORIST, CATERING, DECOR, TRANSPORT, CAKE, OTHER
  contactName  String?
  phone        String?
  email        String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  eventVendors EventVendor[]

  @@index([restaurantId])
}

// A vendor booked for a specific event, with its own cost/status/role so the
// same vendor can serve many events on different terms.
model EventVendor {
  id           String  @id @default(uuid())
  restaurantId String
  eventId      String
  vendorId     String
  role         String? // freeform label; falls back to the vendor's category
  cost         Int? // minor units
  status       String  @default("PENDING") // PENDING, CONFIRMED, CANCELED
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([restaurantId])
  @@index([eventId])
}
