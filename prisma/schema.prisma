generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id           String  @id @default(uuid())
  slug         String  @unique
  name         String
  contactEmail String
  contactPhone String?
  logoUrl      String?
  isActive     Boolean @default(true)

  // Vertical / business type. Drives per-tenant terminology labels and default
  // feature profile. Set by the SysAdmin (like layoutStyle), never by the tenant.
  // RESTAURANT, SALON, SPORTS, COWORKING, CLINIC, WEDDING. See MULTI_BUSINESS_ROADMAP.md.
  businessType String  @default("RESTAURANT")

  // Subscription & Billing
  subscriptionPlan   String    @default("TRIAL") // TRIAL, BASIC, PRO, PREMIUM
  subscriptionStatus String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  subscriptionEndsAt DateTime?
  stripeCustomerId   String?
  sysAdminNotes      String?

  // --- Commercial add-on packages (set by SysAdmin, never by the tenant) ---
  // See docs/packaging/ for the sales/positioning of these two packages.
  //
  // "Hosted Frontend" package: we host the tenant's public booking site on THEIR
  // own domain (customDomain). When off, the tenant is expected to keep their own
  // website and embed the reservation widget instead.
  hasHostedFrontend      Boolean   @default(false)
  // The customer's own domain (e.g. "reservations.lebistro.com"). DNS is pointed
  // at us via CNAME; Caddy on-demand TLS issues the cert. Host-header routing maps
  // this domain to /r/[slug] so the end customer never sees our subdomain.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  //
  // "Reservation Widget" package: an embeddable booking module (JS embed + iframe,
  // plus native SDKs) the tenant drops into their own existing website.
  hasReservationWidget   Boolean   @default(false)
  // Publishable key ("pk_live_...") that scopes public widget/SDK calls to this
  // tenant WITHOUT exposing the internal restaurant UUID. Rotatable by the SysAdmin.
  publicApiKey           String?   @unique

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  menus                 Menu[]
  reservations          Reservation[]
  settings              RestaurantSettings?
  tables                BookableResource[]
  tableTypes            Zone[]
  users                 User[]
  categories            ReservationCategory[]
  daySettings           DaySetting[]
  shifts                Shift[]
  waitTimeConfig        WaitTimeConfig?
  waitlistEntries       WaitlistEntry[]
  floorElements         FloorElement[]
  customization         FrontendCustomization?
  scheduledPriceUpdates ScheduledPriceUpdate[]
  payments              Payment[]
  timeEntries           TimeEntry[]
  events                Event[]
  paymentPlans          PaymentPlan[]
  guests                Guest[]
}

model FrontendCustomization {
  id           String @id @default(uuid())
  restaurantId String @unique

  // New Theming Architecture
  layoutStyle  String @default("CLASSIC_LIST") // CLASSIC_LIST, EDITORIAL_IMAGE, ANIMATED, GARDEN_FRESH
  typography   String @default("SANS") // SANS, SERIF, MONO
  colorPalette String @default("OBSIDIAN") // OBSIDIAN, PEARL, EARTH

  primaryColor String @default("#0f172a") // Keep for backwards compat or custom overrides

  // Features
  announcementText String?
  showAboutUs      Boolean @default(false)
  aboutUsText      String?
  showLegal        Boolean @default(false)
  legalText        String?
  socialLinks      String? // JSON string

  // Reservation Warnings & Information
  reservationInfoText    String?
  reservationWarningText String?

  updatedAt  DateTime   @updatedAt
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model ScheduledPriceUpdate {
  id           String    @id @default(uuid())
  restaurantId String
  updateType   String // PERCENTAGE, FIXED_AMOUNT, EXPLICIT_SET
  value        Float
  isIncrease   Boolean   @default(true)
  // For updateType = EXPLICIT_SET: JSON array of { id, price } target prices set
  // from the bulk price editor (used when the change is scheduled for later).
  payload      String?
  status       String    @default("PENDING") // PENDING, APPLIED, FAILED
  scheduledFor DateTime
  appliedAt    DateTime?

  createdAt  DateTime   @default(now())
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([restaurantId])
}

model RestaurantSettings {
  id                       String  @id @default(uuid())
  restaurantId             String  @unique
  isReservationEnabled     Boolean @default(true)
  logic                    String  @default("DYNAMIC_DURATION")
  defaultDurationMinutes   Int     @default(90)
  // Default unpaid break (minutes) deducted from a scheduled shift when computing
  // worked hours. When a staff member is assigned to a shift but has entered no
  // explicit check-in/out, they are credited with the shift's length minus this
  // break. Admin-configurable; 0 means the full shift counts as worked.
  defaultBreakMinutes      Int     @default(0)
  isPaidReservationEnabled Boolean @default(false)
  depositAmount            Float?
  currency                 String  @default("TRY")
  // Largest party a guest can pick on the public booking form (rendered as
  // 1..maxPartySize bubble buttons). Admin-configurable.
  maxPartySize             Int     @default(8)
  operatingHours           String?
  // Service window as whole hours (0-23), admin-configurable. Drives the public
  // booking time options and bounds the analytics peak-hours heatmap axis so it
  // only spans the hours the restaurant is actually open.
  openingHour              Int     @default(10)
  closingHour              Int     @default(23)
  // IANA timezone (e.g. "Europe/Istanbul") — the authoritative wall-clock zone for
  // this restaurant. Public booking interprets/display times in this zone, and the
  // backend derives the reservation's calendar day (for DaySetting lookups) from it.
  timezone                 String  @default("Europe/Istanbul")

  schedulingSystem String @default("MONTHLY") // "WEEKLY" or "MONTHLY"

  // Feature flags controlled by System Admin
  isVipEnabled           Boolean @default(true)
  isInternalNotesEnabled Boolean @default(true)
  isCategoriesEnabled    Boolean @default(true)

  hasWaitTimeFeature Boolean @default(true)
  hasShiftFeature    Boolean @default(true)
  hasMenuFeature     Boolean @default(true)
  hasPaymentFeature  Boolean @default(true)

  // Wedding/organization vertical capabilities (default off; SysAdmin enables via
  // the WEDDING business profile). See MULTI_BUSINESS_ROADMAP.md Phase 4.
  hasEventPipeline   Boolean @default(false) // Event sales pipeline (lead → confirmed)
  hasInstallmentPlans Boolean @default(false) // kapora + taksit payment schedules
  hasGuestList       Boolean @default(false) // guest list, RSVP, seating assignment

  // Privacy & Staff View Settings
  staffScheduleView String @default("OWN_ONLY") // "OWN_ONLY", "SHIFT_TEAM", "FULL_ROSTER"

  // Two-factor authentication. `twoFactorEnabled` is a capability flag toggled
  // ONLY by the root/system admin per restaurant. When enabled, the tenant admin
  // chooses which roles must use 2FA via `twoFactorRoles` (comma-separated, e.g.
  // "ADMIN,MANAGER"). Staff are excluded by default (empty list).
  twoFactorEnabled  Boolean @default(false)
  twoFactorRoles    String  @default("")

  // Default UI language for this tenant, set by the root/system admin. Applied on
  // the dashboard when a user hasn't explicitly picked a language yet. "tr" is the
  // platform default.
  defaultLanguage   String  @default("tr")

  updatedAt  DateTime   @updatedAt
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model WaitTimeConfig {
  id                   String  @id @default(uuid())
  restaurantId         String  @unique
  isWaitlistOpen       Boolean @default(false)
  isWaitTimeEnabled    Boolean @default(false)
  isWaitTimeCalculated Boolean @default(false) // false = manual, true = calculated

  // Manual Mode
  manualWaitTimeLower Int? // e.g., 30
  manualWaitTimeUpper Int? // e.g., 40

  // Calculated Mode
  peopleWaiting          Int @default(0)
  waitTimePerPersonLower Int @default(5) // in minutes
  waitTimePerPersonUpper Int @default(8) // in minutes

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id             String  @id @default(uuid())
  restaurantId   String
  customerName   String
  customerPhone  String
  partySize      Int
  quotedWaitTime Int? // in minutes
  status         String  @default("WAITING") // WAITING, NOTIFIED, SEATED, CANCELED, NO_SHOW
  notes          String?
  targetDate     String? // YYYY-MM-DD for date-based reservations waitlist

  // Future Reservation Offer Fields
  offerToken     String?   @unique
  offerExpiresAt DateTime?
  offeredTime    String? // e.g. "19:30"

  joinedAt   DateTime  @default(now())
  notifiedAt DateTime?
  seatedAt   DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}

model User {
  id           String  @id @default(uuid())
  restaurantId String?
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String  @default("STAFF") // SUPER_ADMIN, ADMIN, MANAGER, STAFF
  permissions  String? // Comma-separated permission keys e.g. "manage_reservations,manage_menu"
  // E.164 phone (e.g. "+905551234567"). Required for staff so published shift
  // plans can be sent over WhatsApp (#7.6).
  phone        String?

  setupToken          String?   @unique
  setupTokenExpiresAt DateTime?

  // Password reset: only the SHA-256 hash of the token is stored, never the raw
  // token. The raw token lives only in the reset link handed out once.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  // Two-factor (TOTP) authentication. `otpRequired` is toggled only by the root
  // admin; `otpSecret` (base32) is set when the user enrolls; `otpConfirmedAt`
  // marks a completed enrollment. Login enforces OTP only when required + confirmed.
  otpRequired    Boolean   @default(false)
  otpSecret      String?
  otpConfirmedAt DateTime?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  restaurant       Restaurant?            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  availabilities   EmployeeAvailability[]
  shiftAssignments ShiftAssignment[]
  timeEntries      TimeEntry[]
  coordinatedEvents Event[]              @relation("EventCoordinator")

  @@index([restaurantId])
}

// Actual worked-time records entered by staff (own portal) or the admin, per day
// and optionally per shift. When absent, worked hours default to the scheduled
// shift's defined duration (#7.8-#7.10). Times are wall-clock "HH:MM".
model TimeEntry {
  id           String  @id @default(uuid())
  restaurantId String
  userId       String
  date         String // YYYY-MM-DD
  shiftId      String? // optional link to the scheduled shift
  checkIn      String? // "HH:MM"
  checkOut     String? // "HH:MM"
  breakMinutes Int     @default(0)
  source       String  @default("MANUAL") // MANUAL, AUTO
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, date, shiftId])
  @@index([restaurantId])
  @@index([userId])
}

// Canonical name: Zone (a grouping of bookable resources — restaurant section,
// salon station, sports area, clinic department, wedding venue area). Kept mapped
// to the original "TableType" SQL table so no data migration is needed.
model Zone {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  description  String?

  parentId String?
  parent   Zone?  @relation("SubZones", fields: [parentId], references: [id])
  children Zone[] @relation("SubZones")

  tables        BookableResource[]
  floorElements FloorElement[]
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([parentId])
  @@map("TableType")
}

// Canonical name: BookableResource (the unit a booking reserves — restaurant table,
// salon chair, sports court, coworking room, wedding hall). Kept mapped to the
// original "Table" SQL table so no data migration is needed. Relation/field names
// (tableTypeId, tableType, reservations) are retained to keep API shapes stable.
model BookableResource {
  id           String  @id @default(uuid())
  restaurantId String
  tableTypeId  String
  identifier   String
  capacity     Int
  isAvailable  Boolean @default(true)

  // Floor Plan Visuals
  positionX Float   @default(0)
  positionY Float   @default(0)
  shape     String  @default("rectangle") // rectangle, circle
  width     Float   @default(60)
  height    Float   @default(60)
  color     String? @default("#ffffff")

  reservations Reservation[]
  events       Event[]       @relation("EventHall")
  seatedGuests Guest[]       @relation("GuestSeat")
  tableType    Zone          @relation(fields: [tableTypeId], references: [id])
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tableTypeId])
  @@map("Table")
}

model FloorElement {
  id           String  @id @default(uuid())
  restaurantId String
  tableTypeId  String
  type         String  @default("box") // 'box', 'text', 'wall', 'divider'
  label        String?
  positionX    Float   @default(0)
  positionY    Float   @default(0)
  width        Float   @default(200)
  height       Float   @default(200)
  color        String? @default("#f8fafc")

  tableType  Zone       @relation(fields: [tableTypeId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tableTypeId])
}

model DaySetting {
  id                   String     @id @default(uuid())
  restaurantId         String
  date                 String // ISO Date string (YYYY-MM-DD)
  eventTitle           String?
  isReservationEnabled Boolean    @default(true)
  isFullyBooked        Boolean    @default(false)
  autoConfirm          Boolean    @default(false) // If true, skip PENDING and go to CONFIRMED
  maxCapacityOverride  Int? // Optional: limit capacity for special events
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
  @@index([restaurantId])
}

model ReservationCategory {
  id           String        @id @default(uuid())
  restaurantId String
  name         String // Online, Phone, Walk-In
  color        String? // Optional color for UI
  isActive     Boolean       @default(true)
  reservations Reservation[]
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Reservation {
  id            String    @id @default(uuid())
  restaurantId  String
  tableId       String?
  categoryId    String?
  // Appointment verticals (SALON/CLINIC): the service/treatment this booking is
  // for. When set and the service has durationMinutes, the booking window is
  // derived from it instead of RestaurantSettings.defaultDurationMinutes. Optional
  // and unused by restaurants.
  serviceId     String?
  customerName  String
  customerEmail String?
  customerPhone String
  guestCount    Int
  startTime     DateTime
  endTime       DateTime?
  status        String    @default("PENDING")
  notes         String? // Customer note
  internalNote  String? // Internal/Restaurant note
  isVIP         Boolean   @default(false)
  isPaid        Boolean   @default(false)
  paymentId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  table      BookableResource?    @relation(fields: [tableId], references: [id])
  category   ReservationCategory? @relation(fields: [categoryId], references: [id])
  service    MenuItem?            @relation(fields: [serviceId], references: [id])
  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([categoryId])
  @@index([serviceId])
  @@index([startTime])
}

// A payment attempt for a reservation deposit. Provider-agnostic: `provider`
// records which gateway (PAYTR / MOCK / …) handled it. Amounts are stored in
// MINOR units (kuruş/cents) as integers to avoid floating-point money bugs.
// Card data never touches this table — the customer enters it in the provider's
// hosted iframe (PCI SAQ A).
model Payment {
  id            String    @id @default(uuid())
  restaurantId  String
  reservationId String?
  provider      String    @default("PAYTR") // PAYTR, MOCK, STRIPE, IYZICO
  merchantOid   String    @unique // our order id echoed back by the provider callback
  providerRef   String? // provider-side transaction reference
  amount        Int // minor units (e.g. kuruş)
  currency      String    @default("TL")
  status        String    @default("PENDING") // PENDING, PAID, FAILED, EXPIRED, REFUNDED

  // Customer access to the hosted payment page. Only the SHA-256 hash of the raw
  // link token is stored; the raw token lives only in the payment link. `code` is
  // a short human-typeable fallback so guests can reach payment from the known site
  // instead of trusting a raw SMS link (anti-phishing).
  linkTokenHash String    @unique
  code          String
  expiresAt     DateTime

  paidAt        DateTime?
  failReason    String?
  rawCallback   String? // JSON of the last provider callback, for audit

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([reservationId])
  @@index([code])
  @@index([status])
}

model Menu {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  isActive     Boolean @default(true)
  footnotes    String?

  // Scheduling
  startTime  String? // e.g. "10:00"
  endTime    String? // e.g. "14:00"
  daysOfWeek String? // e.g. "1,2,3,4,5" (0=Sun, 6=Sat)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  @@index([restaurantId])
}

model MenuCategory {
  id          String  @id @default(uuid())
  menuId      String
  name        String
  description String?
  imageUrl    String?
  order       Int     @default(0)

  parentId String?
  parent   MenuCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  children MenuCategory[] @relation("SubCategories")

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([menuId])
  @@index([parentId])
}

model MenuItem {
  id          String       @id @default(uuid())
  categoryId  String
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean      @default(true)
  isHighlight Boolean      @default(false) // Chef's Special / Popular
  order       Int          @default(0)
  dietaryTags String? // e.g., "Vegan,Gluten-Free"
  allergens   String? // e.g., "Nuts,Dairy"
  spiceLevel  Int          @default(0) // 0: none, 1: mild, 2: medium, 3: spicy
  // Appointment verticals: intrinsic service/treatment length in minutes. When set
  // on the service a booking references (Reservation.serviceId), it drives the
  // booking window instead of the tenant's default duration. Null for menu dishes.
  durationMinutes Int?

  // Regulation Fields
  ingredients      String?
  calories         Int?
  containsAlcohol  Boolean      @default(false)
  containsPork     Boolean      @default(false)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  modifiers  MenuItemModifier[]
  pairings   MenuItemPairing[]  @relation("ItemPairings")
  pairedWith MenuItemPairing[]  @relation("PairedItems")
  reservations Reservation[]
  events       Event[]          @relation("EventPackage")

  @@index([categoryId])
}

model MenuItemModifier {
  id         String  @id @default(uuid())
  menuItemId String
  name       String // e.g., "Meat Temperature", "Add-ons"
  isRequired Boolean @default(false)
  minChoices Int     @default(0)
  maxChoices Int? // null means unlimited

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([menuItemId])
}

model ModifierOption {
  id          String  @id @default(uuid())
  modifierId  String
  name        String // e.g., "Rare", "Add Bacon"
  priceAdjust Float   @default(0) // e.g., 2.00
  isAvailable Boolean @default(true)

  modifier MenuItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@index([modifierId])
}

model MenuItemPairing {
  id           String @id @default(uuid())
  menuItemId   String
  pairedItemId String

  menuItem   MenuItem @relation("ItemPairings", fields: [menuItemId], references: [id], onDelete: Cascade)
  pairedItem MenuItem @relation("PairedItems", fields: [pairedItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, pairedItemId])
  @@index([menuItemId])
  @@index([pairedItemId])
}

model Shift {
  id           String   @id @default(uuid())
  restaurantId String
  name         String // e.g., "Morning Shift", "Evening Shift"
  startTime    String // e.g., "08:00"
  endTime      String // e.g., "16:00"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant      Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignments     ShiftAssignment[]
  availabilities  EmployeeAvailability[]
  dayRequirements ShiftDayRequirement[]

  @@index([restaurantId])
}

model ShiftDayRequirement {
  id            String @id @default(uuid())
  shiftId       String
  dayOfWeek     Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  requiredStaff Int    @default(1)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, dayOfWeek])
  @@index([shiftId])
}

model ShiftAssignment {
  id          String   @id @default(uuid())
  shiftId     String
  userId      String
  date        String // ISO Date string (YYYY-MM-DD)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId, date])
  @@index([shiftId])
  @@index([userId])
}

model EmployeeAvailability {
  id          String   @id @default(uuid())
  userId      String
  shiftId     String
  date        String // ISO Date string (YYYY-MM-DD)
  isAvailable Boolean  @default(true)
  notes       String? // Reason if not available or preference
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, shiftId, date])
  @@index([userId])
  @@index([shiftId])
}

model GlobalSettings {
  id                        String   @id @default("global_1")
  maintenanceMode           Boolean  @default(false)
  publicRegistrationEnabled Boolean  @default(true)
  enforce2FAForAdmins       Boolean  @default(true)
  // Platform-wide date/time display convention, set by the root system admin.
  // "METRIC" = European/Turkish style: DD/MM/YYYY dates + 24-hour clock.
  // "US"     = United States style: MM/DD/YYYY dates + 12-hour clock (AM/PM).
  measurementSystem         String   @default("METRIC")
  updatedAt                 DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Wedding / organization vertical (Phase 4). New domain isolated in these models.
// An Event is a high-value single-date booking with a sales pipeline, an optional
// per-person package, an installment payment plan (kapora + taksit), and a guest
// list with RSVP + seating. See MULTI_BUSINESS_ROADMAP.md §6.
// ---------------------------------------------------------------------------

model Event {
  id            String   @id @default(uuid())
  restaurantId  String
  resourceId    String? // the Hall (BookableResource) reserved for this date-slot
  packageId     String? // per-person package (MenuItem/CatalogItem)
  coordinatorId String? // assigned staff (User)

  eventType   String  @default("WEDDING") // WEDDING, ENGAGEMENT, HENNA, CORPORATE
  clientName  String
  clientPhone String
  clientEmail String?
  eventDate   String // YYYY-MM-DD (single date-slot; availability via DaySetting-style)
  slot        String? // e.g. "EVENING" / "AFTERNOON"
  guestCount  Int     @default(0)
  // Sales pipeline stage. Transitions validated in the controller.
  stage       String  @default("LEAD") // LEAD, VISIT, QUOTE, CONTRACT, CONFIRMED, COMPLETED, CANCELED
  quotedTotal Int? // minor units (kuruş)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resource    BookableResource? @relation("EventHall", fields: [resourceId], references: [id])
  package     MenuItem?         @relation("EventPackage", fields: [packageId], references: [id])
  coordinator User?             @relation("EventCoordinator", fields: [coordinatorId], references: [id])
  paymentPlan PaymentPlan?
  guests      Guest[]

  @@index([restaurantId])
  @@index([eventDate])
  @@index([stage])
}

model PaymentPlan {
  id           String @id @default(uuid())
  restaurantId String
  eventId      String @unique // one plan per event
  totalAmount  Int    @default(0) // minor units
  currency     String @default("TRY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event        Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  installments PaymentInstallment[]

  @@index([restaurantId])
}

model PaymentInstallment {
  id        String    @id @default(uuid())
  planId    String
  label     String? // e.g. "Kapora", "1. Taksit"
  dueDate   String // YYYY-MM-DD
  amount    Int // minor units
  status    String    @default("PENDING") // PENDING, PAID, OVERDUE
  paidAt    DateTime?
  paymentId String? // links to an existing Payment row when charged

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

model Guest {
  id           String  @id @default(uuid())
  restaurantId String
  eventId      String
  resourceId   String? // seating: assigned guest table (BookableResource)
  name         String
  partySize    Int     @default(1)
  rsvp         String  @default("PENDING") // PENDING, YES, NO, MAYBE
  dietary      String?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resource   BookableResource? @relation("GuestSeat", fields: [resourceId], references: [id])

  @@index([restaurantId])
  @@index([eventId])
}
